# ─────────────────────────────────────────────
# Frontend (read-only) — 不要任何 env も普通に動く
# ─────────────────────────────────────────────
# Canonical URL fallback for sitemap / OG tags. 未設定なら jpluggagego.com。
# NEXT_PUBLIC_SITE_URL=https://jpluggagego.com

# ─────────────────────────────────────────────
# 客戶回報(/feedback → GitHub Issues 経由)— Vercel に設定要
# ─────────────────────────────────────────────
# 未設定だと /feedback ページは描画されるが submit 時 503。
# PAT は fine-grained で対象 repo の Issues:Write のみ付与。
GITHUB_FEEDBACK_REPO=chengyileeca-byte/jpluggagego
GITHUB_FEEDBACK_TOKEN=

# ─────────────────────────────────────────────
# 以下、特定機能にのみ必要(現状 user 0 名で殆ど未使用)
# ─────────────────────────────────────────────

# LINE Messaging API(配送 tracking 通知用 — /api/cron/track 経由)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE Login(/my-reports + 旧 hotel/location reports 用 — 現在 /feedback に
# redirect しているので未設定でも main flow に影響なし)
# Callback URL: https://<site>/api/auth/line/callback
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Session cookie HMAC(LINE Login 利用時のみ必要)
# generate: openssl rand -hex 32
SESSION_SECRET=

# /api/cron/track 認証共有 secret(GitHub Actions 経由で叩く時用)
# generate: openssl rand -hex 32
CRON_SECRET=

# Scraper user-agent(scripts/scrape-* + scripts/fetch-carrier-delays.ts 用)
SCRAPER_USER_AGENT=JPLuggageGoBot/0.1 (+https://jpluggagego.com/bot)

# 楽天トラベル API(scripts/scrape-rakuten-hotels.ts 用 — 無料、application
# 申請のみ)
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# ─────────────────────────────────────────────
# DEPRECATED — 有料 service は使用停止(2026-05、user 課金事故後の方針)
# ─────────────────────────────────────────────
# GOOGLE_PLACES_API_KEY:撤去済。歇業偵測 / Place ID 配對 を担っていた
# が、$200 課金事故を受けて hard-disabled。src/lib/google-places.ts は
# 呼出すと throw する。代替:Wikipedia API + OSM Overpass + 手動。
